# Copia este archivo a secrets.properties (gitignored) y reemplaza el valor con una API key
# real de Google Maps (Google Cloud Console > habilitar "Maps SDK for Android").
# Sin esto, el proyecto compila y corre igual, pero el mapa embebido de seguimiento en vivo
# muestra el watermark "for development purposes only" en vez de imagenes reales.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
