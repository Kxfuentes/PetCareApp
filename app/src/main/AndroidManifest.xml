<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />


    <application
        android:name=".PetCareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetCareApp"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PetCareApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Deep link "petcare://solicitud/{id}" generado por ShareUtils.kt al compartir
                una solicitud. android:launchMode="singleTask" hace que, si la app ya esta
                corriendo, se reutilice la misma instancia (via onNewIntent) en vez de crear
                una segunda encima de la existente.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="petcare"
                    android:host="solicitud" />
            </intent-filter>
        </activity>

        <!--
            Google Maps SDK. La key viene de `secrets.properties` (gitignored) via
            manifestPlaceholders en app/build.gradle.kts; sin una key real ahi, el mapa
            embebido de seguimiento en vivo compila y corre pero muestra el watermark
            "for development purposes only" en vez de imagenes reales (ver comentario en
            app/build.gradle.kts).
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!--
            Firebase Cloud Messaging. Inofensivo sin google-services.json: el sistema solo
            llega a instanciar este servicio si el dispositivo esta registrado ante FCM con
            credenciales reales de Firebase (ver comentario en app/build.gradle.kts).
        -->
        <service
            android:name=".notifications.PetCareFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            FileProvider para la foto de camara al reportar un avistamiento de mascota perdida
            (Bloque 12): content:// en vez de file:// para cumplir con las restricciones de
            Android 7+ sobre exponer rutas file:// a otras apps (la app de camara del sistema).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.proyectopoo.petcareapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>